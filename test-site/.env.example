# Copy this file to .env and fill in real values.
# .env is gitignored - it never gets committed.

# RunPod account-level API key (Settings -> API Keys on runpod.io)
RUNPOD_API_KEY=

# The serverless endpoint to hit. Defaults to Kobold Speed Lab, the
# isolated test endpoint (not the live minimax-h3-video production one).
RUNPOD_ENDPOINT_ID=9ksmzt0ztgwb8h

# S3-compatible network volume credentials, from the same RunPod endpoint's
# environment variables (Settings -> Environment Variables on the endpoint).
RUNPOD_S3_ENDPOINT=
RUNPOD_S3_ACCESS_KEY=
RUNPOD_S3_SECRET_KEY=

# The network volume ID currently attached to Kobold Speed Lab.
RUNPOD_VOLUME_ID=9tjzvfdfju

PORT=3000
